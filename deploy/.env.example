# Copy to deploy/.env and fill in. deploy/.env holds no secret of Wagbook's
# own (the publishable key is public by design), but keep it with the server.
# See docs/14-self-hosting.md.

# Where people open Wagbook, and where Supabase answers. Two names pointing at
# this server. With https:// addresses Caddy gets certificates by itself.
WAGBOOK_DOMAIN=book.example.in
WAGBOOK_PUBLIC_URL=https://book.example.in
SUPABASE_DOMAIN=api.book.example.in
SUPABASE_PUBLIC_URL=https://api.book.example.in
# The host name alone, for the Docker network alias.
SUPABASE_DOMAIN_HOST=api.book.example.in

# From your self-hosted Supabase's .env: the ANON_KEY (Wagbook uses it as the
# publishable key). Never the SERVICE_ROLE_KEY.
SUPABASE_PUBLISHABLE_KEY=

# Where Caddy finds Supabase's API gateway, and the Docker network of
# Supabase's compose project (`docker network ls` shows it).
SUPABASE_UPSTREAM=kong:8000
SUPABASE_NETWORK=supabase_default

# "on" to offer "Continue with Google", after setting up Google in Supabase
# Auth (docs/14-self-hosting.md, Part 1). Leave "off" otherwise.
GOOGLE_SIGN_IN=off

# Alerts on staff phones (M61). Make all four with `node scripts/push-keys.mjs`
# and run the line it prints in the database (docs/14-self-hosting.md,
# "Alerts on phones"). Leave them empty to keep alerts off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_SECRET=
