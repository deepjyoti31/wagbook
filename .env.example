# Copy this file to .env.local and fill it in. See docs/10-setup-and-deploy.md.

# From the Supabase dashboard: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (starts with sb_publishable_). Older projects call it the anon key;
# in that case set NEXT_PUBLIC_SUPABASE_ANON_KEY instead. Either one works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The public address of this Wagbook, with no trailing slash. Used in links sent to parents.
# Leave empty in local development.
NEXT_PUBLIC_SITE_URL=

# "on" to offer "Continue with Google" on the sign-in page, once Google is set up in Supabase Auth.
# See docs/10-setup-and-deploy.md, "Sign in with Google". Leave empty otherwise.
GOOGLE_SIGN_IN=

# Alerts on staff phones (M61). Leave all four empty to keep alerts off.
# Make them with: node scripts/push-keys.mjs (it also prints the line to run in the SQL editor).
# See docs/10-setup-and-deploy.md, "Alerts on phones".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who push services can contact about this Wagbook: mailto:you@example.com or an https address.
VAPID_SUBJECT=
PUSH_SECRET=
